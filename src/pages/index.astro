---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WorkItem from '../components/WorkItem.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works'))
  .filter((w) => w.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const base = import.meta.env.BASE_URL;
---

<BaseLayout description="Rinngo Lab — 用 AI 协作，把想法做成可运行的作品">
  <Header slot="header" />

  <section class="hero container">
    <p class="eyebrow rise">AI 编程作品集</p>
    <h1 class="rise rise-delay-1">Rinngo Lab</h1>
    <p class="lede rise rise-delay-2">
      用 AI 协作，把想法做成可运行的作品。
    </p>
    <div class="actions rise rise-delay-3">
      <a class="btn" href={`${base}works/`}>浏览作品</a>
      <a class="btn btn-ghost" href={`${base}about/`}>关于我</a>
    </div>
  </section>

  <section class="featured container">
    <div class="section-head">
      <h2>精选作品</h2>
      <p>从协作文档、前端交付到自动化工具，三件可讲清来龙去脉的实践。</p>
    </div>
    <div class="list">
      {works.map((work, i) => <WorkItem work={work} index={i} />)}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .hero {
    padding: clamp(3.5rem, 12vh, 6.5rem) 0 3rem;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--accent);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0 0 0.9rem;
    font-size: clamp(2.8rem, 8vw, 4.6rem);
  }

  .lede {
    margin: 0 0 1.6rem;
    max-width: 28rem;
    color: var(--ink-muted);
    font-size: 1.2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .featured {
    padding-bottom: 2rem;
  }

  .section-head {
    margin-bottom: 1.5rem;
  }

  .section-head h2 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .section-head p {
    margin: 0;
    color: var(--ink-muted);
    max-width: 36rem;
  }
</style>
