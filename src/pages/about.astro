---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="关于" description="关于 Rinngo Lab 与 AI 协作方式">
  <Header slot="header" />

  <section class="container page">
    <header class="page-head rise">
      <h1>关于</h1>
      <p>把 AI 当作协作搭档，而不是复制粘贴机器。</p>
    </header>

    <div class="prose rise rise-delay-1">
      <p>
        <strong>Rinngo Lab</strong>
        是我的 AI 编程作品集：展示用 Cursor 等工具协作完成的可运行项目，以及拆任务、验收与部署的过程。
      </p>
      <h2>我怎么协作</h2>
      <ul>
        <li>先写清目标与验收标准，再让 AI 分步生成</li>
        <li>本地跑通、对照需求检查，对结果负责</li>
        <li>交付物包含仓库、预览与可读说明，方便他人审阅</li>
      </ul>
      <h2>联系</h2>
      <p>
        GitHub：
        <a href="https://github.com/Rinngo01" target="_blank" rel="noreferrer">
          @Rinngo01
        </a>
      </p>
      <p>
        <a class="btn" href={`${base}works/`}>查看作品</a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page {
    padding: 3rem 0 2rem;
  }

  .page-head {
    margin-bottom: 1.75rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .page-head p {
    margin: 0;
    color: var(--ink-muted);
  }

  .btn {
    margin-top: 0.5rem;
  }
</style>
